{
  "name": "electron-agent-debug",
  "version": "0.4.0",
  "description": "Electron runtime diagnostics MCP server (attach, inspect, evaluate, screenshot) and Agent skill guidance.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longhun12346/electron-agent-debug.git"
  },
  "bugs": {
    "url": "https://github.com/longhun12346/electron-agent-debug/issues"
  },
  "homepage": "https://github.com/longhun12346/electron-agent-debug",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "dev": "tsx src/index.ts",
    "test": "npm run build && npm run build:skill && tsx --test tests/*.test.ts",
    "test:e2e:external": "node examples/external-e2e/electron-vite-react-smoke.mjs",
    "lint": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
